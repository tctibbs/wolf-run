# Copy this file to .env and fill in the real values.
# .env is ignored by git, so the camera's address and login never get committed.

# The camera in the basement (a Reolink E1 Zoom).
CAMERA_HOST=192.168.1.50
CAMERA_USER=viewer
CAMERA_PASSWORD=change-me
CAMERA_RTSP_PORT=554
CAMERA_ONVIF_PORT=8000

# "sub" is the small stream a Raspberry Pi 3 can keep up with. "main" is full resolution.
CAMERA_STREAM=sub

# Where guests hold a card up to the camera, as left,top,width,height in fractions
# of the camera picture. Leave it out for no outline. See POST /card in the README.
# CARD_OUTLINE=0.4,0.25,0.15,0.4

# Something that knows which pig sits on each of three little houses (see the README).
# Leave it out and the houses on the clock always stand.
# PIG_HOUSES_URL=http://192.168.1.60

# Where scripts/deploy-pi.sh sends the code, as user@host.
WOLF_RUN_PI=you@raspberrypi.local
